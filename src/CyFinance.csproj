<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <StartupObject />
    <AssemblyTitle>C# Yahoo Finance Client</AssemblyTitle>
    <Product>C# Yahoo Finance Client</Product>
    <description>C# Client Library used to interact with the Yahoo Finance API</description>
    <PackageProjectUrl>https://uyttenhovesimon.github.io/CyFinance/</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin/$(Configuration)/$(TargetFramework)/CyFinance.xml</DocumentationFile>
    <!-- CS1573 demands a <param> tag for every parameter as soon as one has one. We
         document the parameters that need explaining and leave the self-evident ones
         alone, so the all-or-nothing rule does not apply here. -->
    <NoWarn>$(NoWarn);CS1573</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Build|AnyCPU'">
    <OutputPath>bin\Build\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

</Project>